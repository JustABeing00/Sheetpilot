# SheetPilot environment template.
# Copy to `.env` for local development. NEVER commit real secrets.

# --- runtime ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Set LOG_PRETTY=true for human-readable development logs (requires pino-pretty).
LOG_PRETTY=false
CORS_ORIGIN=http://localhost:5173

# --- persistence ---
# memory | postgres
# `memory` keeps data in-process (great for local dev and tests, wiped on restart).
REPOSITORY_DRIVER=memory
# Required when REPOSITORY_DRIVER=postgres.
DATABASE_URL=

# --- file storage ---
# local | (future) s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
MAX_UPLOAD_MB=50
# JSON request-body limit (non-multipart endpoints).
JSON_BODY_LIMIT_MB=2
# A .xlsx is a zip; refuse one whose declared contents expand beyond these bounds (zip-bomb guard).
MAX_XLSX_UNCOMPRESSED_MB=512
MAX_XLSX_ENTRIES=20000

# --- retention ---
# Unreferenced uploads older than this are deleted by the background sweep (deliverables are kept).
RETENTION_UPLOAD_TTL_HOURS=168
RETENTION_SWEEP_INTERVAL_MINUTES=60

# --- API security ---
# Leave empty for local/trusted use (no authentication). When set, every /api/v1 route requires the
# matching `x-api-key` header; the /healthz probe stays open. Never commit a real key.
API_KEY=
# Simple per-IP fixed-window rate limit. 0 disables it.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# Set true only when the API is behind a trusted reverse proxy, so client IPs are read correctly.
TRUST_PROXY=false

# --- dataset inspection ---
# How many sample rows are persisted/returned for the preview.
DATASET_SAMPLE_ROWS=10
# Hard cap on rows read during inspection (statistics beyond this are not counted).
DATASET_MAX_SCAN_ROWS=200000

# --- AI assistance (optional, deterministic rules always take precedence) ---
# noop | openai
# `noop` (default) sends nothing anywhere. With `openai`, AI is only consulted per the workflow's
# aiPolicy and never overrides a confident deterministic rule.
AI_PROVIDER=noop
OPENAI_API_KEY=
# Model id used with the openai provider (required when AI_PROVIDER=openai).
AI_MODEL=
# OpenAI-compatible base URL (point at a gateway or local model to avoid a third party).
AI_BASE_URL=https://api.openai.com/v1
# Per-request deadline and total attempts (retries only for timeout/rate-limit/5xx/network).
AI_TIMEOUT_MS=15000
AI_MAX_ATTEMPTS=2
# Comma-separated event/source field names that must never be sent to a provider (data minimisation).
AI_EXCLUDED_FIELDS=

# --- folder inbox (optional) ---
# Drop a day's files into a folder and the configured saved workflow runs automatically.
# Each job is its own subdirectory, e.g. INBOX_DIR/2026-09-19/primary.xlsx + events.xlsx.
# Processed jobs are moved to _processed/, failures to _failed/ (never run twice).
INBOX_ENABLED=false
# Required when INBOX_ENABLED=true. Use an absolute path for a long-running server.
INBOX_DIR=
# Required when INBOX_ENABLED=true. The saved workflow to run: copy the id from its URL
# (http://localhost:5173/saved-workflows/<INBOX_CONFIGURATION_ID>).
INBOX_CONFIGURATION_ID=
# File-name patterns that identify each dataset role inside a job directory.
INBOX_PRIMARY_PATTERN=primary.*
INBOX_EVENTS_PATTERN=events.*
# How often the folder is scanned, and how long a file must stop changing before it is read.
INBOX_POLL_INTERVAL_MS=15000
INBOX_SETTLE_MS=3000
