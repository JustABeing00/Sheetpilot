{
  "name": "sheetpilot",
  "version": "0.1.0",
  "private": true,
  "description": "SheetPilot - recurring spreadsheet workflow automation platform",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @sheetpilot/api",
    "dev:web": "npm run dev -w @sheetpilot/web",
    "build": "npm run build -w @sheetpilot/api && npm run build -w @sheetpilot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node apps/api/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @sheetpilot/db",
    "db:migrate": "npm run db:migrate -w @sheetpilot/db",
    "db:push": "npm run db:push -w @sheetpilot/db",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.8",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  }
}
