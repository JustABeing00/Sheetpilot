{
  "name": "sheetpilot",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.js",
  "preview_urls": false,
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "https://sheetpilot-api.onrender.com"
  }
}
