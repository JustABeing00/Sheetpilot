{
  "name": "sheetpilot",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "https://api.sheetpilot.com"
  }
}
